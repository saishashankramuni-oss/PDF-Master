# PDF Master - Production Environment Variables
# Copy this to .env.production and fill in the values

# Application
APP_NAME=pdf-master
ENVIRONMENT=production

# Server
PORT=8000
HOST=0.0.0.0

# Security (REQUIRED - generate secure random values)
SECRET_KEY=your-super-secret-key-here-min-32-chars
ALLOWED_ORIGINS=https://pdf-master.vercel.app,https://www.pdf-master.com

# File Settings
MAX_FILE_SIZE_MB=50
JOB_RETENTION_MINUTES=30

# CORS
CORS_ORIGINS=https://pdf-master.vercel.app,https://www.pdf-master.com

# Performance
MAX_CONCURRENT_JOBS=5
PROCESSING_TIMEOUT=300

# Optional: Redis for distributed job queue (for scaling)
# REDIS_URL=redis://your-redis-host:6379

# Optional: S3-compatible storage for file persistence
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# S3_BUCKET=pdf-master-files
# S3_ENDPOINT=https://s3.amazonaws.com

# Logging
LOG_LEVEL=INFO

# Frontend (Vercel) Environment Variables
# VITE_API_URL=https://pdf-master-backend.onrender.com